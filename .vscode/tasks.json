{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CosmOS: compilar e executar no QEMU",
            "type": "shell",
            "command": "./copilar.sh && qemu-system-x86_64 -drive format=raw,file=CosmOS.img,if=ide -boot order=c -m 128M",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "Executa o copilar.sh e, se der certo, abre a CosmOS.img no emulador QEMU",
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            }
        }
    ]
}
